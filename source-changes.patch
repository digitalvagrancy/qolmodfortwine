+import {resizedPassageSize} from '../../../util/passage-resize';
+import {
+	clampZoom,
+	fitZoom,
+	roundZoom,
+	stepZoom,
+	wheelZoom
+} from '../../../util/zoom';
+
+describe('zoom helpers', () => {
+	it('clamps to 30% to 100%', () => {
+		expect(clampZoom(0.1)).toBe(0.3);
+		expect(clampZoom(3)).toBe(1);
+		expect(roundZoom(0.4567)).toBe(0.46);
+	});
+
+	it('steps to the next 10% mark', () => {
+		expect(stepZoom(1, -1)).toBe(0.9);
+		expect(stepZoom(0.45, -1)).toBe(0.4);
+		expect(stepZoom(0.45, 1)).toBe(0.5);
+		expect(stepZoom(0.5, 1)).toBe(0.6);
+		expect(stepZoom(0.3, -1)).toBe(0.3);
+		expect(stepZoom(1, 1)).toBe(1);
+	});
+
+	it('zooms in when scrolling up and out when scrolling down', () => {
+		expect(wheelZoom(0.5, -100)).toBeGreaterThan(0.5);
+		expect(wheelZoom(0.5, 100)).toBeLessThan(0.5);
+		expect(wheelZoom(1, -100)).toBe(1);
+	});
+
+	it('fits all passages in a viewport', () => {
+		const passages = [
+			{height: 100, left: 0, top: 0, width: 100},
+			{height: 100, left: 1900, top: 900, width: 100}
+		];
+
+		expect(fitZoom(passages, 1000, 1000)).toBe(0.48);
+		expect(fitZoom([], 1000, 1000)).toBe(1);
+		expect(
+			fitZoom([{height: 100, left: 0, top: 0, width: 100}], 1000, 1000)
+		).toBe(1);
+	});
+});
+
+describe('resizedPassageSize()', () => {
+	it('adds the drag distance, adjusted for zoom', () => {
+		expect(
+			resizedPassageSize({height: 100, width: 100}, 100, 50, 0.5, false)
+		).toEqual({height: 200, width: 300});
+	});
