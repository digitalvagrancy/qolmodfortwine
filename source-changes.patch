diff --git a/src/components/passage/passage-connect-mode.tsx b/src/components/passage/passage-connect-mode.tsx
new file mode 100644
index 0000000..12c6883
--- /dev/null
+++ b/src/components/passage/passage-connect-mode.tsx
@@ -0,0 +1,166 @@
+import * as React from 'react';
+import {usePrefsContext} from '../../store/prefs';
+import {Story, updatePassage} from '../../store/stories';
+import {useUndoableStoriesContext} from '../../store/undoable-stories';
+import {appendLink, makeLink} from '../../util/branch-link';
+import {parseLinks} from '../../util/parse-links';
+import './passage-connect-mode.css';
+
+export interface PassageConnectModeProps {
+	onDone: () => void;
+	sourceId: string;
+	story: Story;
+}
+
+/**
+ * Connect mode: the user has chosen Connect on one passage and now clicks a
+ * second one. The first gets a link to the second. A line follows the mouse
+ * from the first passage, the passage under the mouse is highlighted, and Esc
+ * or a click anywhere else cancels.
+ */
+export const PassageConnectMode: React.FC<PassageConnectModeProps> = ({
+	onDone,
+	sourceId,
+	story
+}) => {
+	const {dispatch} = useUndoableStoriesContext();
+	const {prefs} = usePrefsContext();
+	const [line, setLine] = React.useState<{
+		fromX: number;
+		fromY: number;
+		toX: number;
+		toY: number;
+	}>();
+	const latest = React.useRef({dispatch, onDone, prefs, story});
+
+	latest.current = {dispatch, onDone, prefs, story};
+
+	React.useEffect(() => {
+		const sourceCard = () =>
+			document.querySelector<HTMLElement>(
+				`.passage-card[data-passage-id="${sourceId}"]`
+			);
+		let hovered: Element | null = null;
+
+		function cardAt(x: number, y: number) {
+			return document
+				.elementFromPoint(x, y)
+				?.closest<HTMLElement>('.passage-card[data-passage-id]');
+		}
+
+		function handleMove(event: MouseEvent) {
+			const rect = sourceCard()?.getBoundingClientRect();
+
+			if (rect) {
+				setLine({
+					fromX: rect.left + rect.width / 2,
+					fromY: rect.top + rect.height / 2,
+					toX: event.clientX,
+					toY: event.clientY
+				});
+			}
+
+			const card = cardAt(event.clientX, event.clientY);
+			const target = card && card.dataset.passageId !== sourceId ? card : null;
+
+			if (target !== hovered) {
+				hovered?.classList.remove('connect-target');
+				target?.classList.add('connect-target');
+				hovered = target;
+			}
+		}
+
+		function connect(targetId: string) {
+			const {dispatch, prefs, story} = latest.current;
+			const source = story.passages.find(p => p.id === sourceId);
+			const target = story.passages.find(p => p.id === targetId);
+
+			if (!source || !target || parseLinks(source.text).includes(target.name)) {
+				return;
+			}
+
+			dispatch(
+				updatePassage(story, source, {
+					text: appendLink(
+						source.text,
+						makeLink(prefs.linkTemplate, target.name)
+					)
+				}),
+				'undoChange.connectPassages'
+			);
+		}
+
+		// While connecting, clicks must not select, drag or open passages, so we
+		// intercept them before Twine sees them.
+
+		function handleDown(event: MouseEvent) {
+			event.preventDefault();
+			event.stopPropagation();
+
+			const card = cardAt(event.clientX, event.clientY);
+
+			if (
+				event.button === 0 &&
+				card?.dataset.passageId &&
+				card.dataset.passageId !== sourceId
+			) {
+				connect(card.dataset.passageId);
+			}
+
+			latest.current.onDone();
+		}
+
+		function swallow(event: Event) {
+			event.preventDefault();
+			event.stopPropagation();
+		}
+
+		function handlePointerDown(event: Event) {
+			event.stopPropagation();
+		}
+
+		function handleKey(event: KeyboardEvent) {
+			if (event.key === 'Escape') {
+				event.stopPropagation();
+				latest.current.onDone();
+			}
+		}
+
+		sourceCard()?.classList.add('connect-source');
+		document.body.classList.add('connect-mode');
+		window.addEventListener('mousemove', handleMove, true);
+		window.addEventListener('pointerdown', handlePointerDown, true);
+		window.addEventListener('mousedown', handleDown, true);
+		window.addEventListener('mouseup', swallow, true);
+		window.addEventListener('click', swallow, true);
+		window.addEventListener('dblclick', swallow, true);
+		window.addEventListener('contextmenu', swallow, true);
+		window.addEventListener('keydown', handleKey, true);
+
+		return () => {
+			sourceCard()?.classList.remove('connect-source');
+			hovered?.classList.remove('connect-target');
+			document.body.classList.remove('connect-mode');
+			window.removeEventListener('mousemove', handleMove, true);
+			window.removeEventListener('pointerdown', handlePointerDown, true);
+			window.removeEventListener('mousedown', handleDown, true);
+			window.removeEventListener('mouseup', swallow, true);
+			window.removeEventListener('click', swallow, true);
+			window.removeEventListener('dblclick', swallow, true);
+			window.removeEventListener('contextmenu', swallow, true);
+			window.removeEventListener('keydown', handleKey, true);
+		};
+	}, [sourceId]);
+
+	if (!line) {
+		return null;
+	}
+
+	return (
+		<svg className="passage-connect-line">
+			<line x1={line.fromX} x2={line.toX} y1={line.fromY} y2={line.toY} />
+			<circle cx={line.fromX} cy={line.fromY} r={6} />
+			<circle cx={line.toX} cy={line.toY} r={4} />
+		</svg>
+	);
+};
