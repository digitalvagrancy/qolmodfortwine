+++ b/src/components/passage/tag-outline.ts
@@ -0,0 +1,84 @@
+/**
+ * How far the outline peeks out past the edge of a passage card, in pixels.
+ * Keep this in sync with `inset` in passage-card.css.
+ */
+export const tagOutlineWidth = 4;
+
+/**
+ * Returns a CSS `conic-gradient()` that paints a rectangle's outline divided
+ * evenly, by length along the edge, between the colors given: halves for two
+ * colors, thirds for three, and so on. The first color starts at the bottom
+ * center and the rest follow clockwise (so two colors are left and right).
+ */
+export function tagOutlineGradient(
+	colors: string[],
+	cardWidth: number,
+	cardHeight: number
+) {
+	if (colors.length === 1) {
+		return `conic-gradient(var(--${colors[0]}), var(--${colors[0]}))`;
+	}
+
+	const w = cardWidth + tagOutlineWidth * 2;
+	const h = cardHeight + tagOutlineWidth * 2;
+	const perimeter = 2 * (w + h);
+
+	// Position on the rectangle's edge, relative to its center, a given distance
+	// clockwise from the bottom center. Y increases downward.
+
+	function pointAt(distance: number) {
+		let d = distance;
+
+		if (d <= w / 2) {
+			return {x: -d, y: h / 2};
+		}
+
+		d -= w / 2;
+
+		if (d <= h) {
+			return {x: -w / 2, y: h / 2 - d};
+		}
+
+		d -= h;
+
+		if (d <= w) {
+			return {x: -w / 2 + d, y: -h / 2};
+		}
+
+		d -= w;
+
+		if (d <= h) {
+			return {x: w / 2, y: -h / 2 + d};
+		}
+
+		d -= h;
+		return {x: w / 2 - d, y: h / 2};
+	}
+
+	// The gradient starts at 180deg (bottom center) and runs clockwise, so we
+	// express each boundary as an angle relative to that.
+
+	function angleAt(fraction: number) {
+		if (fraction <= 0) {
+			return 0;
+		}
+
+		if (fraction >= 1) {
+			return 360;
+		}
+
+		const {x, y} = pointAt(fraction * perimeter);
+		const fromTop = (Math.atan2(x, -y) * 180) / Math.PI;
+
+		return (((fromTop - 180) % 360) + 360) % 360;
+	}
+
+	const stops = colors.map((color, index) => {
+		const start = angleAt(index / colors.length).toFixed(2);
+		const end = angleAt((index + 1) / colors.length).toFixed(2);
+
+		return `var(--${color}) ${start}deg ${end}deg`;
+	});
+
+	return `conic-gradient(from 180deg, ${stops.join(', ')})`;
+}
