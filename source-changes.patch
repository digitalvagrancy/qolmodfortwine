+import * as React from 'react';
+import {DialogCard} from '../../components/container/dialog-card';
+import {TagGrid} from '../../components/tag';
+import {VisibleWhitespace} from '../../components/visible-whitespace';
+import {
+	Passage,
+	passageWithId,
+	storyWithId,
+	useStoriesContext
+} from '../../store/stories';
+import {DialogComponentProps} from '../dialogs.types';
+import {PassageEditContents} from '../passage-edit/passage-edit-contents';
+import './passage-pin.css';
+
+export interface PassagePinProps extends DialogComponentProps {
+	passageId: string;
+	storyId: string;
+}
+
+/**
+ * A passage editor that stays put in its own column beside the main dialogs,
+ * so it can be used as a reference while writing other passages.
+ */
+export const PassagePin: React.FC<PassagePinProps> = props => {
+	// eslint-disable-next-line @typescript-eslint/no-unused-vars
+	const {onChangeProps, onClose, passageId, storyId, ...managementProps} =
+		props;
+	const {stories} = useStoriesContext();
+	let passage: Passage | undefined;
+	let tagColors = {};
+
+	try {
+		passage = passageWithId(stories, storyId, passageId);
+		tagColors = storyWithId(stories, storyId).tagColors;
+	} catch {
+		passage = undefined;
+	}
+
+	// If the passage has been deleted, close this pin.
+
+	React.useEffect(() => {
+		if (!passage) {
+			onClose();
+		}
+	}, [onClose, passage]);
+
+	if (!passage) {
+		return null;
+	}
+
+	return (
+		<DialogCard
+			{...managementProps}
+			className="passage-pin"
+			headerDisplayLabel={
+				<>
+					<TagGrid tags={passage.tags} tagColors={tagColors} />
+					<VisibleWhitespace value={passage.name} />
+				</>
+			}
+			headerLabel={passage.name}
+			onClose={() => onClose()}
+		>
+			<PassageEditContents passageId={passageId} storyId={storyId} />
+		</DialogCard>
+	);
+};
diff --git a/src/dialogs/saved-windows.ts b/src/dialogs/saved-windows.ts
new file mode 100644
index 0000000..745f01f
--- /dev/null
+++ b/src/dialogs/saved-windows.ts
@@ -0,0 +1,236 @@
+import * as React from 'react';
+import {Thunk} from 'react-hook-thunk-reducer';
+import {setPref, usePrefsContext} from '../store/prefs';
+import {Story} from '../store/stories';
+import {useDialogsContext} from './context';
+import {addPassageEditors} from './context/action-creators';
+import {DialogsAction, DialogsState} from './dialogs.types';
+import {PassageEditStack} from './passage-edit';
+import {PassagePin} from './passage-pin';
+import {PassageTagsDialog} from './passage-tags';
+import {StoryDetailsDialog} from './story-details';
+import {StoryJavaScriptDialog} from './story-javascript';
+import {StoryStylesheetDialog} from './story-stylesheet';
+
+/**
+ * A window that gets reopened the next time a story is opened.
+ */
+export type SavedWindow =
+	| {collapsed?: boolean; passageNames: string[]; type: 'edit'}
+	| {collapsed?: boolean; passageName: string; type: 'pin'; width?: number}
+	| {
+			collapsed?: boolean;
+			type: 'details' | 'javascript' | 'passageTags' | 'stylesheet';
+	  };
+
+const storyDialogs = [
+	{component: StoryStylesheetDialog, type: 'stylesheet'},
+	{component: StoryJavaScriptDialog, type: 'javascript'},
+	{component: StoryDetailsDialog, type: 'details'},
+	{component: PassageTagsDialog, type: 'passageTags'}
+] as const;
+
+/**
+ * Describes the open windows that belong to a story, in order.
+ *
+ * Passages are saved by name. The desktop app gives every story and passage a
+ * new internal ID each time it loads them from disk, so IDs can't be used to
+ * find them again after the app is restarted.
+ */
+export function snapshotWindows(
+	dialogs: DialogsState,
+	story: Pick<Story, 'id' | 'passages'>
+): SavedWindow[] {
+	const saved: SavedWindow[] = [];
+	const nameOf = (id: unknown) =>
+		story.passages.find(passage => passage.id === id)?.name;
+
+	for (const dialog of dialogs) {
+		if (dialog.props?.storyId !== story.id) {
+			continue;
+		}
+
+		const collapsed = dialog.collapsed || undefined;
+
+		if (dialog.component === PassageEditStack) {
+			const passageNames = (dialog.props.passageIds as string[])
+				.map(nameOf)
+				.filter((name): name is string => name !== undefined);
+
+			if (passageNames.length > 0) {
+				saved.push({collapsed, passageNames, type: 'edit'});
+			}
+		} else if (dialog.component === PassagePin) {
+			const passageName = nameOf(dialog.props.passageId);
+
+			if (passageName !== undefined) {
+				saved.push({
+					collapsed,
+					passageName,
+					type: 'pin',
+					width: dialog.props.width
+				});
+			}
+		} else {
+			const match = storyDialogs.find(
+				({component}) => component === dialog.component
+			);
+
+			if (match) {
+				saved.push({collapsed, type: match.type});
+			}
+		}
+	}
+
+	return saved;
+}
+
+/**
+ * Reads the saved windows preference, ignoring anything that isn't usable.
+ */
+export function parseSavedWindows(json: string): Record<string, SavedWindow[]> {
+	try {
+		const parsed = JSON.parse(json);
+
+		if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+			return parsed;
+		}
+	} catch {
+		// Fall through.
+	}
+
+	return {};
+}
+
+/**
+ * Reopens saved windows for a story, skipping passages that no longer exist.
+ */
+export function restoreWindows(
+	story: Story,
+	windows: SavedWindow[]
+): Thunk<DialogsState, DialogsAction> {
+	const idOf = (name: unknown) =>
+		typeof name === 'string'
+			? story.passages.find(passage => passage.name === name)?.id
+			: undefined;
+
+	return (dispatch, getState) => {
+		for (const saved of windows) {
+			let index = -1;
+
+			if (saved.type === 'edit') {
+				const passageIds = (saved.passageNames ?? [])
+					.map(idOf)
+					.filter((id): id is string => id !== undefined);
+
+				if (passageIds.length > 0) {
+					dispatch(addPassageEditors(story.id, passageIds));
+					index = getState().findIndex(
+						dialog => dialog.component === PassageEditStack
+					);
+				}
+			} else if (saved.type === 'pin') {
+				const passageId = idOf(saved.passageName);
+
+				if (passageId) {
+					dispatch({
+						type: 'addDialog',
+						component: PassagePin,
+						props: {
+							passageId,
+							storyId: story.id,
+							...(typeof saved.width === 'number' ? {width: saved.width} : {})
+						}
+					});
+					index = getState().length - 1;
+				}
+			} else {
+				const match = storyDialogs.find(({type}) => type === saved.type);
+
+				if (match) {
+					dispatch({
+						type: 'addDialog',
+						component: match.component,
+						props: {storyId: story.id}
+					});
+					index = getState().length - 1;
+				}
+			}
+
+			if (index !== -1 && saved.collapsed) {
+				dispatch({type: 'setDialogCollapsed', collapsed: true, index});
+			}
+		}
+	};
+}
+
+/**
+ * Remembers which windows are open for a story, and reopens them the next time
+ * the story is opened.
+ */
+export function useSavedWindows(story: Story) {
+	const {dispatch: prefsDispatch, prefs} = usePrefsContext();
+	const {dispatch, dialogs} = useDialogsContext();
+	const ready = React.useRef(false);
+	const latest = React.useRef({dialogs, prefs, story});
+
+	latest.current = {dialogs, prefs, story};
+
+	const save = React.useCallback(() => {
+		const {
+			dialogs: currentDialogs,
+			prefs: currentPrefs,
+			story: s
+		} = latest.current;
+		const all = parseSavedWindows(currentPrefs.savedWindows);
+		const snapshot = snapshotWindows(currentDialogs, s);
+
+		// A story's IFID is the one thing that identifies it from one session of
+		// the app to the next.
+
+		if (snapshot.length > 0) {
+			all[s.ifid] = snapshot;
+		} else {
+			delete all[s.ifid];
+		}
+
+		const json = JSON.stringify(all);
+
+		if (json !== currentPrefs.savedWindows) {
+			prefsDispatch(setPref('savedWindows', json));
+		}
+	}, [prefsDispatch]);
+
+	// Reopen what was open last time.
+
+	React.useEffect(() => {
+		const saved = parseSavedWindows(latest.current.prefs.savedWindows)[
+			latest.current.story.ifid
+		];
+
+		if (saved && saved.length > 0) {
+			dispatch(restoreWindows(latest.current.story, saved));
+		}
+
+		ready.current = true;
+		// This only runs once, when the story is opened.
+	}, []);
+
+	// Save a moment after the windows change, and again on the way out. The
+	// windows are saved by passage name, so a passage being renamed counts as a
+	// change too.
+
+	const snapshot = JSON.stringify(snapshotWindows(dialogs, story));
+
+	React.useEffect(() => {
+		if (!ready.current) {
+			return;
+		}
+
+		const timer = window.setTimeout(save, 500);
+
+		return () => window.clearTimeout(timer);
+	}, [save, snapshot]);
+
+	React.useEffect(() => save, [save]);
+}
