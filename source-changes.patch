+export const defaultLinkTemplate = '[[▹ Label.->{passage}]]';
+
+/**
+ * Builds a link from a template, replacing {passage} with the target name. If
+ * the template has no {passage} in it, the default template is used instead so
+ * we never produce a link that goes nowhere.
+ */
+export function makeLink(template: string, passageName: string) {
+	const usable = template.includes('{passage}')
+		? template
+		: defaultLinkTemplate;
+
+	return usable.split('{passage}').join(passageName);
+}
+
+/**
+ * Adds a link to the end of passage text. Links that follow other links go on
+ * the next line; anything else gets a blank line first.
+ */
+export function appendLink(text: string, link: string) {
+	const trimmed = text.replace(/\s+$/, '');
+
+	if (trimmed === '') {
+		return link;
+	}
+
+	const lastLine = trimmed.split('\n').pop() ?? '';
+
+	return `${trimmed}${lastLine.trimStart().startsWith('[[') ? '\n' : '\n\n'}${link}`;
+}
