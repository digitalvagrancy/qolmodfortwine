+export const minPassageSize = 100;
+const gridSize = 25;
+
+/**
+ * Size of a passage card while its corner handle is dragged. `scale` is how
+ * much the story map is zoomed, so on-screen movement is converted back to map
+ * units. Never smaller than the minimum, and snapped to the grid if asked.
+ */
+export function resizedPassageSize(
+	start: {height: number; width: number},
+	dragX: number,
+	dragY: number,
+	scale: number,
+	snapToGrid: boolean
+) {
+	const safeScale = scale > 0 ? scale : 1;
+	let width = start.width + dragX / safeScale;
+	let height = start.height + dragY / safeScale;
+
+	if (snapToGrid) {
+		width = Math.round(width / gridSize) * gridSize;
+		height = Math.round(height / gridSize) * gridSize;
+	}
+
+	return {
+		height: Math.max(minPassageSize, Math.round(height)),
+		width: Math.max(minPassageSize, Math.round(width))
+	};
+}
