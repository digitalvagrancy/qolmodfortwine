diff --git a/src/components/passage/__tests__/tag-outline.test.ts b/src/components/passage/__tests__/tag-outline.test.ts
new file mode 100644
index 0000000..84b4ece
--- /dev/null
+++ b/src/components/passage/__tests__/tag-outline.test.ts
@@ -0,0 +1,28 @@
+import {tagOutlineGradient} from '../tag-outline';
+
+describe('tagOutlineGradient()', () => {
+	it('returns a solid color for one color', () => {
+		expect(tagOutlineGradient(['red'], 100, 100)).toBe(
+			'conic-gradient(var(--red), var(--red))'
+		);
+	});
+
+	it('splits two colors into exact halves', () => {
+		const result = tagOutlineGradient(['red', 'blue'], 200, 100);
+
+		expect(result).toContain('var(--red) 0.00deg 180.00deg');
+		expect(result).toContain('var(--blue) 180.00deg 360.00deg');
+	});
+
+	it('splits three colors by edge length, not by angle', () => {
+		// On a square, the thirds are 144px of the 432px perimeter, which places the
+		// first boundary partway up the left edge (about 123.7 degrees around from
+		// the bottom center).
+
+		const result = tagOutlineGradient(['red', 'green', 'blue'], 100, 100);
+
+		expect(result).toContain('var(--red) 0.00deg 123.69deg');
+		expect(result).toContain('var(--green) 123.69deg 236.31deg');
+		expect(result).toContain('var(--blue) 236.31deg 360.00deg');
+	});
+});
