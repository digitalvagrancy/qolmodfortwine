@@ -0,0 +1,48 @@
+import * as React from 'react';
+import {Story, updatePassage} from '../../store/stories';
+import {useUndoableStoriesContext} from '../../store/undoable-stories';
+
+export const passageResizeEvent = 'qol:passage-resize';
+
+export interface PassageResizeDetail {
+	height: number;
+	passageId: string;
+	width: number;
+}
+
+/**
+ * Saves a passage's new size when its card's resize handle is let go. Cards
+ * announce this with a window event so they don't each have to be wired up to
+ * the story.
+ */
+export function usePassageResize(story: Story) {
+	const {dispatch} = useUndoableStoriesContext();
+	const storyRef = React.useRef(story);
+
+	storyRef.current = story;
+
+	React.useEffect(() => {
+		function handleResize(event: Event) {
+			const {height, passageId, width} = (
+				event as CustomEvent<PassageResizeDetail>
+			).detail;
+			const current = storyRef.current;
+			const passage = current.passages.find(p => p.id === passageId);
+
+			if (passage && (passage.width !== width || passage.height !== height)) {
+				dispatch(
+					updatePassage(
+						current,
+						passage,
+						{height, width},
+						{dontUpdateOthers: true}
+					),
+					'undoChange.resizePassage'
+				);
+			}
+		}
+
+		window.addEventListener(passageResizeEvent, handleResize);
+		return () => window.removeEventListener(passageResizeEvent, handleResize);
+	}, [dispatch]);
+}
