+import {PassageEditStack} from '../passage-edit';
+import {PassagePin} from '../passage-pin';
+import {StoryStylesheetDialog} from '../story-stylesheet';
+import {parseSavedWindows, snapshotWindows} from '../saved-windows';
+import {Dialog} from '../dialogs.types';
+
+function dialog(partial: Partial<Dialog>): Dialog {
+	return {
+		collapsed: false,
+		component: () => null,
+		highlighted: false,
+		maximized: false,
+		...partial
+	};
+}
+
+const story = {
+	id: 's1',
+	passages: [
+		{id: 'p1', name: 'CODE'},
+		{id: 'p2', name: 'Open1'},
+		{id: 'p3', name: 'Open2'}
+	]
+} as any;
+
+describe('snapshotWindows()', () => {
+	it("describes this story's windows in order, with passages by name", () => {
+		expect(
+			snapshotWindows(
+				[
+					dialog({
+						component: PassagePin,
+						props: {passageId: 'p1', storyId: 's1', width: 420}
+					}),
+					dialog({
+						collapsed: true,
+						component: PassageEditStack,
+						props: {passageIds: ['p2', 'p3'], storyId: 's1'}
+					}),
+					dialog({component: StoryStylesheetDialog, props: {storyId: 's1'}})
+				],
+				story
+			)
+		).toEqual([
+			{collapsed: undefined, passageName: 'CODE', type: 'pin', width: 420},
+			{collapsed: true, passageNames: ['Open1', 'Open2'], type: 'edit'},
+			{collapsed: undefined, type: 'stylesheet'}
+		]);
+	});
+
+	it('skips passages that no longer exist', () => {
+		expect(
+			snapshotWindows(
+				[
+					dialog({
+						component: PassagePin,
+						props: {passageId: 'gone', storyId: 's1'}
+					})
+				],
+				story
+			)
+		).toEqual([]);
+	});
+
+	it('ignores other stories and dialogs it does not know', () => {
+		expect(
+			snapshotWindows(
+				[
+					dialog({
+						component: PassagePin,
+						props: {passageId: 'p1', storyId: 'other'}
+					}),
+					dialog({props: {storyId: 's1'}}),
+					dialog({})
+				],
+				story
+			)
+		).toEqual([]);
+	});
+});
+
+describe('parseSavedWindows()', () => {
+	it('reads saved windows', () => {
+		expect(parseSavedWindows('{"s1":[{"type":"stylesheet"}]}')).toEqual({
+			s1: [{type: 'stylesheet'}]
+		});
+	});
+
+	it.each(['', 'nope', '[1]', 'null', '5'])(
+		'returns nothing for unusable value "%s"',
+		value => expect(parseSavedWindows(value)).toEqual({})
+	);
+});
