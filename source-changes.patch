@@ -0,0 +1,65 @@
+import * as React from 'react';
+import {useTranslation} from 'react-i18next';
+import {updateStory, useStoriesContext, Story} from '../../../store/stories';
+import {roundZoom} from '../../../util/zoom';
+import './zoom-select.css';
+
+export interface ZoomSelectProps {
+	onFit: () => void;
+	story: Story;
+}
+
+const presets = [30, 40, 50, 60, 70, 80, 90, 100];
+
+/**
+ * A percentage dropdown for the story map zoom, with a Fit All option.
+ */
+export const ZoomSelect: React.FC<ZoomSelectProps> = React.memo(
+	({onFit, story}) => {
+		const {dispatch, stories} = useStoriesContext();
+		const {t} = useTranslation();
+		const percent = Math.round(story.zoom * 100);
+		const options = presets.includes(percent)
+			? presets
+			: [...presets, percent].sort((a, b) => a - b);
+
+		function handleChange(event: React.ChangeEvent<HTMLSelectElement>) {
+			// Give up focus so the keyboard zoom shortcuts work straight away.
+
+			event.target.blur();
+
+			if (event.target.value === 'fit') {
+				onFit();
+				return;
+			}
+
+			dispatch(
+				updateStory(stories, story, {
+					zoom: roundZoom(Number(event.target.value) / 100)
+				})
+			);
+		}
+
+		return (
+			<div className="zoom-buttons zoom-select">
+				<label htmlFor="story-zoom-select">
+					{t('routes.storyEdit.zoomSelect.legend')}
+				</label>
+				<select
+					id="story-zoom-select"
+					onChange={handleChange}
+					value={String(percent)}
+				>
+					{options.map(option => (
+						<option key={option} value={String(option)}>
+							{option}%
+						</option>
+					))}
+					<option value="fit">{t('routes.storyEdit.zoomSelect.fit')}</option>
+				</select>
+			</div>
+		);
+	}
+);
+
+ZoomSelect.displayName = 'ZoomSelect';
