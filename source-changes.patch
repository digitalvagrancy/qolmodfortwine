+import {appendLink, makeLink} from '../branch-link';
+import {linesToArray} from '../lines-to-array';
+import {copyName, nextNumberedName} from '../passage-names';
+import {relinkChapbookInserts} from '../relink-chapbook';
+
+describe('nextNumberedName()', () => {
+	it('adds 1 to a name with no number', () => {
+		expect(nextNumberedName('Title', ['Title'])).toBe('Title1');
+	});
+
+	it('increments a trailing number', () => {
+		expect(nextNumberedName('Open1', ['Open1'])).toBe('Open2');
+		expect(nextNumberedName('Open.Slow9', [])).toBe('Open.Slow10');
+	});
+
+	it('skips numbers that are already used', () => {
+		expect(nextNumberedName('Open.Slow1', ['Open.Slow2'])).toBe('Open.Slow3');
+	});
+});
+
+describe('copyName()', () => {
+	it('adds copy, then numbers it if needed', () => {
+		expect(copyName('Open1', [])).toBe('Open1 copy');
+		expect(copyName('Open1', ['Open1 copy'])).toBe('Open1 copy 2');
+		expect(copyName('Open1', ['Open1 copy', 'Open1 copy 2'])).toBe(
+			'Open1 copy 3'
+		);
+	});
+});
+
+describe('makeLink() and appendLink()', () => {
+	it('fills in the passage name', () => {
+		expect(makeLink('[[▹ Label.->{passage}]]', 'Open2')).toBe(
+			'[[▹ Label.->Open2]]'
+		);
+	});
+
+	it('falls back to the default template if there is no {passage}', () => {
+		expect(makeLink('[[nothing]]', 'Open2')).toBe('[[▹ Label.->Open2]]');
+	});
+
+	it('puts a link on its own after other text with a blank line', () => {
+		expect(appendLink('Hello there.', '[[x->A]]')).toBe(
+			'Hello there.\n\n[[x->A]]'
+		);
+		expect(appendLink('', '[[x->A]]')).toBe('[[x->A]]');
+	});
+
+	it('puts a link on the next line after another link', () => {
+		expect(appendLink('Hello.\n\n[[a->B]]\n', '[[x->A]]')).toBe(
+			'Hello.\n\n[[a->B]]\n[[x->A]]'
+		);
+	});
+});
+
+describe('linesToArray()', () => {
+	it('turns lines into an array', () => {
+		expect(linesToArray('a\nb\n\n c ')).toBe("['a', 'b', 'c']");
+	});
+
+	it('escapes quotes and backslashes', () => {
+		expect(linesToArray("it's\nback\\slash")).toBe(
+			"['it\\'s', 'back\\\\slash']"
+		);
+	});
+});
+
+describe('relinkChapbookInserts()', () => {
+	it('updates the passage in link to and embed passage inserts', () => {
+		expect(
+			relinkChapbookInserts("{link to: 'Old', label: 'Old'}", 'Old', 'New')
+		).toBe("{link to: 'New', label: 'Old'}");
+		expect(relinkChapbookInserts('{embed passage: "Old"}', 'Old', 'New')).toBe(
+			'{embed passage: "New"}'
+		);
+	});
+
+	it('updates the passage option of reveal link inserts', () => {
+		expect(
+			relinkChapbookInserts(
+				"{reveal link: 'Old', passage: 'Old'}",
+				'Old',
+				'New'
+			)
+		).toBe("{reveal link: 'Old', passage: 'New'}");
+	});
+
+	it('leaves other text and other passages alone', () => {
+		const text = "Old {link to: 'Other'} {back link}";
+
+		expect(relinkChapbookInserts(text, 'Old', 'New')).toBe(text);
+	});
+
+	it('escapes a quote in the new name', () => {
+		expect(relinkChapbookInserts("{link to: 'Old'}", 'Old', "Bob's")).toBe(
+			"{link to: 'Bob\\'s'}"
+		);
+	});
+});
