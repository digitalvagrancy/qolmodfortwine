diff --git a/src/routes/story-edit/use-double-click-create.ts b/src/routes/story-edit/use-double-click-create.ts
new file mode 100644
index 0000000..8a68349
--- /dev/null
+++ b/src/routes/story-edit/use-double-click-create.ts
@@ -0,0 +1,72 @@
+import * as React from 'react';
+import {Passage, Story, createUntitledPassage} from '../../store/stories';
+import {useUndoableStoriesContext} from '../../store/undoable-stories';
+
+/**
+ * Lets the user double-click empty space in the story map to create a passage
+ * there and open it for editing.
+ */
+export function useDoubleClickCreate(
+	story: Story,
+	container: React.RefObject<HTMLElement>,
+	onEdit: (passage: Passage) => void
+) {
+	const {dispatch} = useUndoableStoriesContext();
+	const storyRef = React.useRef(story);
+	const pendingName = React.useRef<string | undefined>();
+
+	storyRef.current = story;
+
+	React.useEffect(() => {
+		const element = container.current;
+
+		if (!element) {
+			return;
+		}
+
+		function handleDoubleClick(event: MouseEvent) {
+			const target = event.target as HTMLElement | null;
+
+			// Only react to the empty map background, not cards, buttons or dialogs.
+
+			if (
+				!element ||
+				!target ||
+				target.closest('.passage-card, button, a, input, textarea')
+			) {
+				return;
+			}
+
+			const current = storyRef.current;
+			const rect = element.getBoundingClientRect();
+			const action = createUntitledPassage(
+				current,
+				(event.clientX - rect.left + element.scrollLeft) / current.zoom,
+				(event.clientY - rect.top + element.scrollTop) / current.zoom
+			);
+
+			pendingName.current = action.props.name;
+			dispatch(action, 'undoChange.newPassage');
+		}
+
+		element.addEventListener('dblclick', handleDoubleClick);
+		return () => element.removeEventListener('dblclick', handleDoubleClick);
+	}, [container, dispatch]);
+
+	// Once the new passage exists in the story, open it for editing.
+
+	React.useEffect(() => {
+		if (!pendingName.current) {
+			return;
+		}
+
+		const created = story.passages.find(
+			passage => passage.name === pendingName.current
+		);
+
+		if (created) {
+			pendingName.current = undefined;
+			onEdit(created);
+		}
+	}, [onEdit, story.passages]);
+}
