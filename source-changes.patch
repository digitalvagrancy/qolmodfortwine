diff --git a/src/components/passage/delete-confirm.tsx b/src/components/passage/delete-confirm.tsx
new file mode 100644
index 0000000..1954248
--- /dev/null
+++ b/src/components/passage/delete-confirm.tsx
@@ -0,0 +1,70 @@
+import * as React from 'react';
+import {useTranslation} from 'react-i18next';
+import './delete-confirm.css';
+
+export interface DeleteConfirmProps {
+	/**
+	 * Names of the passages about to be deleted.
+	 */
+	names: string[];
+	onCancel: () => void;
+	onConfirm: () => void;
+}
+
+/**
+ * A small "are you sure?" window for deleting passages with the keyboard.
+ * Enter confirms (the Delete button starts focused) and Escape cancels.
+ */
+export const DeleteConfirm: React.FC<DeleteConfirmProps> = ({
+	names,
+	onCancel,
+	onConfirm
+}) => {
+	const {t} = useTranslation();
+	const confirmButton = React.useRef<HTMLButtonElement>(null);
+
+	React.useEffect(() => {
+		confirmButton.current?.focus();
+	}, []);
+
+	React.useEffect(() => {
+		function handleKeyDown(event: KeyboardEvent) {
+			if (event.key === 'Escape') {
+				event.preventDefault();
+				event.stopPropagation();
+				onCancel();
+			}
+		}
+
+		window.addEventListener('keydown', handleKeyDown, true);
+		return () => window.removeEventListener('keydown', handleKeyDown, true);
+	}, [onCancel]);
+
+	return (
+		<div className="delete-confirm-backdrop" onMouseDown={onCancel}>
+			<div
+				aria-modal="true"
+				className="delete-confirm"
+				onMouseDown={event => event.stopPropagation()}
+				role="alertdialog"
+			>
+				<p className="delete-confirm-message">
+					{names.length === 1
+						? t('components.deleteConfirm.one', {name: names[0]})
+						: t('components.deleteConfirm.many', {count: names.length})}
+				</p>
+				<p className="delete-confirm-hint">
+					{t('components.deleteConfirm.hint')}
+				</p>
+				<div className="delete-confirm-buttons">
+					<button onClick={onCancel} type="button">
+						{t('common.cancel')}
+					</button>
+					<button onClick={onConfirm} ref={confirmButton} type="button">
+						{t('common.delete')}
+					</button>
+				</div>
+			</div>
+		</div>
+	);
+};
