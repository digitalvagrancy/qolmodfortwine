+import escapeRegExp from 'lodash/escapeRegExp';
+
+function quoted(name: string, quote: string) {
+	return name.replace(/\\/g, '\\\\').split(quote).join(`\\${quote}`);
+}
+
+/**
+ * Updates Chapbook inserts that refer to a passage by name, such as
+ * {link to: 'Old name'} and {embed passage: 'Old name'}, after the passage is
+ * renamed. Only the exact passage-name value is changed, never labels.
+ */
+export function relinkChapbookInserts(
+	text: string,
+	oldName: string,
+	newName: string
+) {
+	const old = escapeRegExp(oldName);
+
+	return text.replace(/\{[^{}]*\}/g, block => {
+		const key = block.match(/^\{\s*([a-z ]+?)\s*:/i)?.[1].toLowerCase();
+
+		if (key === 'link to' || key === 'embed passage') {
+			return block.replace(
+				new RegExp(`^(\\{\\s*${key}\\s*:\\s*)(['"])${old}\\2`, 'i'),
+				(_, before: string, quote: string) =>
+					`${before}${quote}${quoted(newName, quote)}${quote}`
+			);
+		}
+
+		if (key === 'reveal link') {
+			return block.replace(
+				new RegExp(`(\\bpassage\\s*:\\s*)(['"])${old}\\2`, 'i'),
+				(_, before: string, quote: string) =>
+					`${before}${quote}${quoted(newName, quote)}${quote}`
+			);
+		}
+
+		return block;
+	});
+}
