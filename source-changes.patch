+import {Passage} from '../store/stories';
+
+export const minZoom = 0.3;
+export const maxZoom = 1;
+
+/**
+ * Keeps a zoom value in the range the story map supports.
+ */
+export function clampZoom(zoom: number) {
+	return Math.min(maxZoom, Math.max(minZoom, zoom));
+}
+
+/**
+ * Rounds a zoom value for storing in a story, so story files stay tidy.
+ */
+export function roundZoom(zoom: number) {
+	return Math.round(clampZoom(zoom) * 100) / 100;
+}
+
+/**
+ * Steps a zoom value to the next 10% mark, in or out.
+ */
+export function stepZoom(zoom: number, direction: 1 | -1) {
+	const next =
+		direction > 0
+			? Math.floor(zoom * 10 + 1e-6) / 10 + 0.1
+			: Math.ceil(zoom * 10 - 1e-6) / 10 - 0.1;
+
+	return roundZoom(next);
+}
+
+/**
+ * Zoom value after a mouse wheel or trackpad pinch event. Scrolling up zooms
+ * in. The result isn't rounded, so very small trackpad movements add up.
+ */
+export function wheelZoom(zoom: number, deltaY: number) {
+	return clampZoom(zoom * Math.exp(-deltaY * 0.0015));
+}
+
+/**
+ * The largest zoom at which every passage fits in a viewport, never zooming in
+ * past 100%.
+ */
+export function fitZoom(
+	passages: Pick<Passage, 'height' | 'left' | 'top' | 'width'>[],
+	viewportWidth: number,
+	viewportHeight: number
+) {
+	if (passages.length === 0 || viewportWidth <= 0 || viewportHeight <= 0) {
+		return 1;
+	}
+
+	const margin = 50;
+	const right = Math.max(...passages.map(p => p.left + p.width)) + margin;
+	const bottom = Math.max(...passages.map(p => p.top + p.height)) + margin;
+
+	return (
+		Math.floor(
+			clampZoom(Math.min(1, viewportWidth / right, viewportHeight / bottom)) *
+				100
+		) / 100
+	);
+}
