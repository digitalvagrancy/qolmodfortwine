+/**
+ * Returns a name for a passage that continues the number at the end of an
+ * existing name ("Open1" becomes "Open2"), or adds a 1 if there isn't one
+ * ("Title" becomes "Title1"). Skips any number that's already taken.
+ */
+export function nextNumberedName(name: string, existing: string[]) {
+	const match = name.match(/^(.*?)(\d+)$/);
+	const base = match ? match[1] : name;
+	let number = match ? parseInt(match[2], 10) + 1 : 1;
+
+	while (existing.includes(`${base}${number}`)) {
+		number++;
+	}
+
+	return `${base}${number}`;
+}
+
+/**
+ * Returns a name for a duplicate of a passage: "Name copy", then "Name copy 2",
+ * "Name copy 3" and so on if those are taken.
+ */
+export function copyName(name: string, existing: string[]) {
+	let candidate = `${name} copy`;
+	let number = 2;
+
+	while (existing.includes(candidate)) {
+		candidate = `${name} copy ${number}`;
+		number++;
+	}
+
+	return candidate;
+}
