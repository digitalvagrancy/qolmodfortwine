+
+/**
+ * Moves a passage editor out of the main editing stack and into its own pinned
+ * column.
+ */
+export function pinPassageEditor(
+	storyId: string,
+	passageId: string
+): Thunk<DialogsState, DialogsAction> {
+	return (dispatch, getState) => {
+		// If this passage is already pinned, leave that pin alone.
+
+		const alreadyPinned = getState().some(
+			dialog =>
+				dialog.component === PassagePin && dialog.props?.passageId === passageId
+		);
+
+		if (!alreadyPinned) {
+			dispatch({
+				type: 'addDialog',
+				component: PassagePin,
+				props: {storyId, passageId}
+			});
+		}
+
+		dispatch(removePassageEditors([passageId]));
+	};
+}
