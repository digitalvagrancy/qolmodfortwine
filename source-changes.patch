@@ -0,0 +1,27 @@
+import * as React from 'react';
+
+/**
+ * Holding Alt while scrolling the mouse wheel over the story map scrolls it
+ * sideways instead of up and down.
+ */
+export function useAltScroll(container: React.RefObject<HTMLElement>) {
+	React.useEffect(() => {
+		const element = container.current;
+
+		if (!element) {
+			return;
+		}
+
+		function handleWheel(event: WheelEvent) {
+			if (!event.altKey || !element) {
+				return;
+			}
+
+			event.preventDefault();
+			element.scrollLeft += event.deltaY || event.deltaX;
+		}
+
+		element.addEventListener('wheel', handleWheel, {passive: false});
+		return () => element.removeEventListener('wheel', handleWheel);
+	}, [container]);
+}
diff --git a/src/routes/story-edit/use-double-click-create.ts b/src/routes/story-edit/use-double-click-create.ts
new file mode 100644
index 0000000..6a02937
--- /dev/null
+++ b/src/routes/story-edit/use-double-click-create.ts
@@ -0,0 +1,118 @@
+import * as React from 'react';
+import {Passage, Story, createUntitledPassage} from '../../store/stories';
+import {useUndoableStoriesContext} from '../../store/undoable-stories';
+
+/**
+ * Lets the user double-click empty space in the story map to create a passage
+ * there and open it for editing.
+ */
+export function useDoubleClickCreate(
+	story: Story,
+	container: React.RefObject<HTMLElement>,
+	onEdit: (passage: Passage) => void
+) {
+	const {dispatch} = useUndoableStoriesContext();
+	const storyRef = React.useRef(story);
+	const pendingName = React.useRef<string | undefined>();
+
+	storyRef.current = story;
+
+	React.useEffect(() => {
+		const element = container.current;
+
+		if (!element) {
+			return;
+		}
+
+		function handleDoubleClick(event: MouseEvent) {
+			const target = event.target as HTMLElement | null;
+
+			// Only react to the empty map background, not cards, buttons or dialogs.
+
+			if (
+				!element ||
+				!target ||
+				target.closest('.passage-card, button, a, input, textarea')
+			) {
+				return;
+			}
+
+			const current = storyRef.current;
+			const rect = element.getBoundingClientRect();
+			const action = createUntitledPassage(
+				current,
+				(event.clientX - rect.left + element.scrollLeft) / current.zoom,
+				(event.clientY - rect.top + element.scrollTop) / current.zoom
+			);
+
+			pendingName.current = action.props.name;
+			dispatch(action, 'undoChange.newPassage');
+		}
+
+		element.addEventListener('dblclick', handleDoubleClick);
+		return () => element.removeEventListener('dblclick', handleDoubleClick);
+	}, [container, dispatch]);
+
+	// Once the new passage exists in the story, open it for editing.
+
+	React.useEffect(() => {
+		if (!pendingName.current) {
+			return;
+		}
+
+		const created = story.passages.find(
+			passage => passage.name === pendingName.current
+		);
+
+		if (created) {
+			pendingName.current = undefined;
+			onEdit(created);
+
+			// Then act as if the user clicked Rename in the new editor, so the name is
+			// ready to type. Esc leaves the default name in place.
+
+			window.setTimeout(() => {
+				const rename = Array.from(
+					document.querySelectorAll<HTMLButtonElement>('.dialogs button')
+				).find(
+					button => !button.disabled && button.textContent?.trim() === 'Rename'
+				);
+
+				rename?.click();
+
+				// Twine's dialogs close themselves on Escape, which would also close the
+				// editor when the user cancels the rename. Keep the editor open, and
+				// move the cursor into the passage text once the name is settled.
+
+				window.setTimeout(() => {
+					const popover = document.querySelector('.dialogs .card-button-card');
+
+					function focusText() {
+						const editor = document.querySelector<
+							HTMLElement & {CodeMirror?: {focus: () => void}}
+						>('.dialogs .CodeMirror');
+
+						editor?.CodeMirror?.focus();
+					}
+
+					popover?.addEventListener('keydown', event => {
+						const key = (event as KeyboardEvent).key;
+
+						if (key === 'Escape') {
+							event.stopPropagation();
+							window.setTimeout(focusText, 100);
+						} else if (key === 'Enter') {
+							// If the name was rejected, the popover stays open; leave it be.
+
+							window.setTimeout(() => {
+								if (!document.querySelector('.dialogs .card-button-card')) {
+									focusText();
+								}
+							}, 500);
+						}
+					});
+				}, 100);
+			}, 250);
+		}
+	}, [onEdit, story.passages]);
+}
