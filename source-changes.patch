+import * as React from 'react';
+import {DialogCard} from '../../components/container/dialog-card';
+import {TagGrid} from '../../components/tag';
+import {VisibleWhitespace} from '../../components/visible-whitespace';
+import {
+	Passage,
+	passageWithId,
+	storyWithId,
+	useStoriesContext
+} from '../../store/stories';
+import {DialogComponentProps} from '../dialogs.types';
+import {PassageEditContents} from '../passage-edit/passage-edit-contents';
+import './passage-pin.css';
+
+export interface PassagePinProps extends DialogComponentProps {
+	passageId: string;
+	storyId: string;
+}
+
+/**
+ * A passage editor that stays put in its own column beside the main dialogs,
+ * so it can be used as a reference while writing other passages.
+ */
+export const PassagePin: React.FC<PassagePinProps> = props => {
+	// eslint-disable-next-line @typescript-eslint/no-unused-vars
+	const {onChangeProps, onClose, passageId, storyId, ...managementProps} =
+		props;
+	const {stories} = useStoriesContext();
+	let passage: Passage | undefined;
+	let tagColors = {};
+
+	try {
+		passage = passageWithId(stories, storyId, passageId);
+		tagColors = storyWithId(stories, storyId).tagColors;
+	} catch {
+		passage = undefined;
+	}
+
+	// If the passage has been deleted, close this pin.
+
+	React.useEffect(() => {
+		if (!passage) {
+			onClose();
+		}
+	}, [onClose, passage]);
+
+	if (!passage) {
+		return null;
+	}
+
+	return (
+		<DialogCard
+			{...managementProps}
+			className="passage-pin"
+			headerDisplayLabel={
+				<>
+					<TagGrid tags={passage.tags} tagColors={tagColors} />
+					<VisibleWhitespace value={passage.name} />
+				</>
+			}
+			headerLabel={passage.name}
+			onClose={() => onClose()}
+		>
+			<PassageEditContents passageId={passageId} storyId={storyId} />
+		</DialogCard>
+	);
+};
