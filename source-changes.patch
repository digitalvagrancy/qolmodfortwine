+import * as React from 'react';
+import {Story, updateStory, useStoriesContext} from '../../store/stories';
+import {Point} from '../../util/geometry';
+import {fitZoom, roundZoom, wheelZoom} from '../../util/zoom';
+import {useZoomTransition} from './use-zoom-transition';
+
+/**
+ * Handles zooming the story map: the animated zoom itself, smooth zooming with
+ * Ctrl+scroll (or trackpad pinch) around the mouse pointer, and fitting all
+ * passages in view.
+ */
+export function useStoryZoom(
+	story: Story,
+	container: React.RefObject<HTMLElement>
+) {
+	const {dispatch, stories} = useStoriesContext();
+	const [pending, setPending] = React.useState<number>();
+	const anchor = React.useRef<Point>();
+	const duration = React.useRef(500);
+	const latest = React.useRef({pending, stories, story});
+	const timer = React.useRef<number>();
+	const target = pending ?? story.zoom;
+	const visible = useZoomTransition(target, container.current, {
+		anchor,
+		duration
+	});
+
+	latest.current = {pending, stories, story};
+
+	const resetTransitionOptions = React.useCallback(() => {
+		anchor.current = undefined;
+		duration.current = 500;
+	}, []);
+
+	// Ctrl+scroll zooms around the pointer. The story itself is only updated once
+	// the user pauses, so we aren't saving the story on every wheel event.
+
+	React.useEffect(() => {
+		const element = container.current;
+
+		if (!element) {
+			return;
+		}
+
+		function handleWheel(event: WheelEvent) {
+			if (!element || !(event.ctrlKey || event.metaKey)) {
+				return;
+			}
+
+			event.preventDefault();
+
+			const rect = element.getBoundingClientRect();
+			const base = latest.current.pending ?? latest.current.story.zoom;
+			const next = wheelZoom(base, event.deltaY);
+
+			anchor.current = {
+				left: event.clientX - rect.left,
+				top: event.clientY - rect.top
+			};
+			duration.current = 100;
+			latest.current.pending = next;
+			setPending(next);
+
+			window.clearTimeout(timer.current);
+			timer.current = window.setTimeout(() => {
+				const {stories: currentStories, story: currentStory} = latest.current;
+
+				dispatch(
+					updateStory(currentStories, currentStory, {zoom: roundZoom(next)})
+				);
+				setPending(undefined);
+				resetTransitionOptions();
+			}, 300);
+		}
+
+		element.addEventListener('wheel', handleWheel, {passive: false});
+		return () => element.removeEventListener('wheel', handleWheel);
+	}, [container, dispatch, resetTransitionOptions]);
+
+	React.useEffect(() => () => window.clearTimeout(timer.current), []);
+
+	const fit = React.useCallback(() => {
+		const element = container.current;
+
+		if (!element) {
+			return;
+		}
+
+		// Zoom with the top left of the map held in place.
+
+		const {stories: currentStories, story: currentStory} = latest.current;
+		const zoom = fitZoom(
+			currentStory.passages,
+			element.clientWidth,
+			element.clientHeight
+		);
+
+		element.scrollLeft = 0;
+		element.scrollTop = 0;
+		anchor.current = {left: 0, top: 0};
+		duration.current = 300;
+		dispatch(updateStory(currentStories, currentStory, {zoom}));
+		window.setTimeout(resetTransitionOptions, 500);
+	}, [container, dispatch, resetTransitionOptions]);
+
+	return {fit, target, visible};
+}
