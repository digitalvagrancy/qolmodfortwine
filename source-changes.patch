index 0000000..17e08ba
--- /dev/null
+++ b/src/components/passage/passage-context-menu.tsx
@@ -0,0 +1,572 @@
+import * as React from 'react';
+import {useTranslation} from 'react-i18next';
+import {usePrefsContext} from '../../store/prefs';
+import {
+	Passage,
+	Story,
+	deletePassages,
+	storyPassageTags,
+	updatePassage
+} from '../../store/stories';
+import {useUndoableStoriesContext} from '../../store/undoable-stories';
+import {appendLink, makeLink} from '../../util/branch-link';
+import {rectsIntersect} from '../../util/geometry';
+import {copyName, nextNumberedName} from '../../util/passage-names';
+import {PassageConnectMode} from './passage-connect-mode';
+import './passage-context-menu.css';
+
+export interface PassageContextMenuProps {
+	story: Story;
+}
+
+interface MenuState {
+	passageIds: string[];
+	x: number;
+	y: number;
+}
+
+/**
+ * Finds a free spot for a copy of a passage: to the right of it if there's
+ * room, then below, moving further out until nothing overlaps.
+ */
+function placeCopy(
+	passage: Passage,
+	taken: {height: number; left: number; top: number; width: number}[]
+) {
+	const gap = 25;
+
+	for (let step = 1; step <= 30; step++) {
+		const candidates = [
+			{col: step, row: 0},
+			{col: 0, row: step},
+			{col: step, row: step}
+		];
+
+		for (const {col, row} of candidates) {
+			const bounds = {
+				height: passage.height,
+				left: passage.left + col * (passage.width + gap),
+				top: passage.top + row * (passage.height + gap),
+				width: passage.width
+			};
+
+			if (!taken.some(other => rectsIntersect(other, bounds))) {
+				return bounds;
+			}
+		}
+	}
+
+	return {
+		height: passage.height,
+		left: passage.left + 25,
+		top: passage.top + 25,
+		width: passage.width
+	};
+}
+
+/**
+ * Keeps a fixed-position element fully on screen.
+ */
+function useKeepOnScreen(
+	ref: React.RefObject<HTMLElement>,
+	x: number,
+	y: number,
+	active: boolean
+) {
+	React.useLayoutEffect(() => {
+		const el = ref.current;
+
+		if (!active || !el) {
+			return;
+		}
+
+		const rect = el.getBoundingClientRect();
+
+		el.style.left = `${Math.max(4, Math.min(x, window.innerWidth - rect.width - 4))}px`;
+		el.style.top = `${Math.max(4, Math.min(y, window.innerHeight - rect.height - 4))}px`;
+	}, [active, ref, x, y]);
+}
+
+interface RenamePromptProps {
+	onClose: () => void;
+	passage: Passage;
+	story: Story;
+	x: number;
+	y: number;
+}
+
+const RenamePrompt: React.FC<RenamePromptProps> = ({
+	onClose,
+	passage,
+	story,
+	x,
+	y
+}) => {
+	const {dispatch} = useUndoableStoriesContext();
+	const {t} = useTranslation();
+	const [name, setName] = React.useState(passage.name);
+	const ref = React.useRef<HTMLFormElement>(null);
+	const input = React.useRef<HTMLInputElement>(null);
+
+	useKeepOnScreen(ref, x, y, true);
+
+	// Start with the current name highlighted, ready to be typed over.
+
+	React.useEffect(() => {
+		input.current?.focus();
+		input.current?.select();
+	}, []);
+
+	React.useEffect(() => {
+		function handleKeyDown(event: KeyboardEvent) {
+			if (event.key === 'Escape') {
+				onClose();
+			}
+		}
+
+		function handleMouseDown(event: MouseEvent) {
+			if (!ref.current?.contains(event.target as Node)) {
+				onClose();
+			}
+		}
+
+		window.addEventListener('keydown', handleKeyDown, true);
+		window.addEventListener('mousedown', handleMouseDown, true);
+		return () => {
+			window.removeEventListener('keydown', handleKeyDown, true);
+			window.removeEventListener('mousedown', handleMouseDown, true);
+		};
+	}, [onClose]);
+
+	let error: string | undefined;
+
+	if (name.trim() === '') {
+		error = t('components.renamePassageButton.emptyName');
+	} else if (story.passages.some(p => p.id !== passage.id && p.name === name)) {
+		error = t('components.renamePassageButton.nameAlreadyUsed');
+	}
+
+	function handleSubmit(event: React.FormEvent) {
+		event.preventDefault();
+
+		if (error) {
+			return;
+		}
+
+		if (name !== passage.name) {
+			// Same options as the editor's Rename button. Links in other passages
+			// are updated by updatePassage itself.
+
+			dispatch(
+				updatePassage(story, passage, {name}, {dontUpdateOthers: true}),
+				'undoChange.renamePassage'
+			);
+		}
+
+		onClose();
+	}
+
+	return (
+		<form
+			className="passage-context-menu passage-rename-prompt"
+			onSubmit={handleSubmit}
+			ref={ref}
+			style={{left: x, top: y}}
+		>
+			<label className="passage-context-menu-title" htmlFor="passage-rename">
+				{t('common.renamePrompt', {name: passage.name})}
+			</label>
+			<input
+				id="passage-rename"
+				onChange={event => setName(event.target.value)}
+				ref={input}
+				spellCheck={false}
+				type="text"
+				value={name}
+			/>
+			{error && <div className="passage-rename-error">{error}</div>}
+			<div className="passage-rename-buttons">
+				<button onClick={onClose} type="button">
+					{t('common.cancel')}
+				</button>
+				<button disabled={!!error} type="submit">
+					{t('common.rename')}
+				</button>
+			</div>
+		</form>
+	);
+};
+
+/**
+ * Right-click menu for passage cards in the story map. Offers Rename, Branch,
+ * Duplicate and Delete, then lists the story's existing tags to toggle on the
+ * clicked passage (or on every selected passage, if the clicked one is part of
+ * a multiple selection).
+ */
+export const PassageContextMenu: React.FC<PassageContextMenuProps> = ({
+	story
+}) => {
+	const {dispatch} = useUndoableStoriesContext();
+	const {prefs} = usePrefsContext();
+	const {t} = useTranslation();
+	const [menu, setMenu] = React.useState<MenuState | null>(null);
+	const [renaming, setRenaming] = React.useState<MenuState | null>(null);
+	const [connecting, setConnecting] = React.useState<string | null>(null);
+	const menuRef = React.useRef<HTMLDivElement>(null);
+	const storyRef = React.useRef(story);
+	const rightDown = React.useRef<{x: number; y: number} | null>(null);
+
+	storyRef.current = story;
+
+	// Open on right-click of a passage card. Twine lets you pan the map by
+	// dragging with the right button, so we ignore right-clicks that moved.
+
+	React.useEffect(() => {
+		function handlePointerDown(event: PointerEvent) {
+			if (event.button === 2) {
+				rightDown.current = {x: event.clientX, y: event.clientY};
+			}
+		}
+
+		function handleContextMenu(event: MouseEvent) {
+			const start = rightDown.current;
+
+			rightDown.current = null;
+
+			if (
+				start &&
+				Math.hypot(event.clientX - start.x, event.clientY - start.y) > 4
+			) {
+				return;
+			}
+
+			const hit = document.elementFromPoint(event.clientX, event.clientY);
+			const card = hit?.closest<HTMLElement>('.passage-card[data-passage-id]');
+
+			if (!card || !card.dataset.passageId) {
+				setMenu(null);
+				return;
+			}
+
+			const current = storyRef.current;
+			const clicked = current.passages.find(
+				passage => passage.id === card.dataset.passageId
+			);
+
+			if (!clicked) {
+				return;
+			}
+
+			const selected = current.passages.filter(passage => passage.selected);
+			const passageIds =
+				clicked.selected && selected.length > 1
+					? selected.map(passage => passage.id)
+					: [clicked.id];
+
+			event.preventDefault();
+			setRenaming(null);
+			setMenu({passageIds, x: event.clientX, y: event.clientY});
+		}
+
+		window.addEventListener('pointerdown', handlePointerDown, true);
+		window.addEventListener('contextmenu', handleContextMenu, true);
+		return () => {
+			window.removeEventListener('pointerdown', handlePointerDown, true);
+			window.removeEventListener('contextmenu', handleContextMenu, true);
+		};
+	}, []);
+
+	// Close on outside click, Escape, scrolling, resizing or losing focus.
+
+	React.useEffect(() => {
+		if (!menu) {
+			return;
+		}
+
+		function close() {
+			setMenu(null);
+		}
+
+		function handleMouseDown(event: MouseEvent) {
+			if (
+				event.button === 0 &&
+				!menuRef.current?.contains(event.target as Node)
+			) {
+				close();
+			}
+		}
+
+		function handleKeyDown(event: KeyboardEvent) {
+			if (event.key === 'Escape') {
+				close();
+			}
+		}
+
+		window.addEventListener('mousedown', handleMouseDown, true);
+		window.addEventListener('keydown', handleKeyDown, true);
+		window.addEventListener('wheel', close, true);
+		window.addEventListener('resize', close);
+		window.addEventListener('blur', close);
+		return () => {
+			window.removeEventListener('mousedown', handleMouseDown, true);
+			window.removeEventListener('keydown', handleKeyDown, true);
+			window.removeEventListener('wheel', close, true);
+			window.removeEventListener('resize', close);
+			window.removeEventListener('blur', close);
+		};
+	}, [menu]);
+
+	useKeepOnScreen(menuRef, menu?.x ?? 0, menu?.y ?? 0, !!menu);
+
+	if (connecting) {
+		return (
+			<PassageConnectMode
+				onDone={() => setConnecting(null)}
+				sourceId={connecting}
+				story={story}
+			/>
+		);
+	}
+
+	if (renaming) {
+		const passage = story.passages.find(p => p.id === renaming.passageIds[0]);
+
+		return passage ? (
+			<RenamePrompt
+				onClose={() => setRenaming(null)}
+				passage={passage}
+				story={story}
+				x={renaming.x}
+				y={renaming.y}
+			/>
+		) : null;
+	}
+
+	if (!menu) {
+		return null;
+	}
+
+	const targets = story.passages.filter(passage =>
+		menu.passageIds.includes(passage.id)
+	);
+
+	if (targets.length === 0) {
+		return null;
+	}
+
+	const single = targets.length === 1 ? targets[0] : undefined;
+
+	// Tags that are in use, plus tags that still have a color set from earlier.
+
+	const tags = Array.from(
+		new Set([...storyPassageTags(story), ...Object.keys(story.tagColors)])
+	).sort((a, b) => a.localeCompare(b));
+
+	function handleRename() {
+		setRenaming(menu);
+		setMenu(null);
+	}
+
+	function handleConnect() {
+		if (single) {
+			setConnecting(single.id);
+			setMenu(null);
+		}
+	}
+
+	function handleBranch() {
+		if (!single) {
+			return;
+		}
+
+		// Add a link at the end of the passage. Twine creates and positions the
+		// newly linked passage itself.
+
+		const newName = nextNumberedName(
+			single.name,
+			story.passages.map(passage => passage.name)
+		);
+		const text = appendLink(single.text, makeLink(prefs.linkTemplate, newName));
+
+		dispatch(updatePassage(story, single, {text}), 'undoChange.branchPassage');
+		setMenu(null);
+	}
+
+	function handleDuplicate() {
+		const names = story.passages.map(passage => passage.name);
+		const taken = story.passages.map(passage => ({...passage}));
+		const props = targets.map(target => {
+			const name = copyName(target.name, names);
+			const bounds = placeCopy(target, taken);
+
+			names.push(name);
+			taken.push({...target, ...bounds});
+
+			return {
+				...bounds,
+				name,
+				story: story.id,
+				tags: [...target.tags],
+				text: target.text
+			};
+		});
+
+		dispatch(
+			{type: 'createPassages', props, storyId: story.id},
+			'undoChange.duplicatePassages'
+		);
+		setMenu(null);
+	}
+
+	function handleDelete() {
+		dispatch(
+			deletePassages(story, targets),
+			targets.length === 1
+				? 'undoChange.deletePassage'
+				: 'undoChange.deletePassages'
+		);
+		setMenu(null);
+	}
+
+	function toggle(tag: string) {
+		const allHave = targets.every(passage => passage.tags.includes(tag));
+		const storyId = story.id;
+		const changes = targets
+			.filter(passage => passage.tags.includes(tag) === allHave)
+			.map(passage => ({
+				id: passage.id,
+				tags: allHave
+					? passage.tags.filter(existing => existing !== tag)
+					: [...passage.tags, tag]
+			}));
+
+		// Dispatched directly (rather than via addPassageTag) so that an existing
+		// tag color is never reset.
+
+		dispatch(
+			innerDispatch => {
+				for (const change of changes) {
+					innerDispatch({
+						type: 'updatePassage',
+						passageId: change.id,
+						props: {tags: change.tags},
+						storyId
+					});
+				}
+			},
+			allHave ? 'undoChange.removeTag' : 'undoChange.addTag'
+		);
+
+		// The menu stays open so several tags can be changed in a row.
+	}
+
+	return (
+		<div
+			className="passage-context-menu"
+			onContextMenu={event => event.preventDefault()}
+			ref={menuRef}
+			role="menu"
+			style={{left: menu.x, top: menu.y}}
+		>
+			<button
+				className="passage-context-menu-item"
+				disabled={!single}
+				onClick={handleRename}
+				role="menuitem"
+				type="button"
+			>
+				<span className="name">
+					{t('components.passageContextMenu.rename')}
+				</span>
+			</button>
+			<button
+				className="passage-context-menu-item"
+				disabled={!single}
+				onClick={handleBranch}
+				role="menuitem"
+				type="button"
+			>
+				<span className="name">
+					{t('components.passageContextMenu.branch')}
+				</span>
+			</button>
+			<button
+				className="passage-context-menu-item"
+				disabled={!single}
+				onClick={handleConnect}
+				role="menuitem"
+				type="button"
+			>
+				<span className="name">
+					{t('components.passageContextMenu.connect')}
+				</span>
+			</button>
+			<button
+				className="passage-context-menu-item"
+				onClick={handleDuplicate}
+				role="menuitem"
+				type="button"
+			>
+				<span className="name">
+					{targets.length === 1
+						? t('components.passageContextMenu.duplicate')
+						: t('components.passageContextMenu.duplicateMany', {
+								count: targets.length
+							})}
+				</span>
+			</button>
+			<button
+				className="passage-context-menu-item"
+				onClick={handleDelete}
+				role="menuitem"
+				type="button"
+			>
+				<span className="name">
+					{targets.length === 1
+						? t('components.passageContextMenu.delete')
+						: t('components.passageContextMenu.deleteMany', {
+								count: targets.length
+							})}
+				</span>
+			</button>
+			<div className="passage-context-menu-divider" role="separator" />
+			<div className="passage-context-menu-title">
+				{targets.length === 1
+					? t('components.passageTagMenu.titleOne', {name: targets[0].name})
+					: t('components.passageTagMenu.titleMany', {count: targets.length})}
+			</div>
+			{tags.length === 0 && (
+				<div className="passage-context-menu-empty">
+					{t('components.passageTagMenu.noTags')}
+				</div>
+			)}
+			{tags.map(tag => {
+				const checked = targets.every(passage => passage.tags.includes(tag));
+				const some =
+					!checked && targets.some(passage => passage.tags.includes(tag));
+				const color = story.tagColors[tag];
+
+				return (
+					<button
+						aria-checked={checked ? 'true' : some ? 'mixed' : 'false'}
+						className="passage-context-menu-item"
+						key={tag}
+						onClick={() => toggle(tag)}
+						role="menuitemcheckbox"
+						type="button"
+					>
+						<span className="check">{checked ? '✓' : some ? '–' : ''}</span>
+						<span
+							className="swatch"
+							style={{
+								background:
+									color && color !== 'none' ? `var(--${color})` : 'transparent'
+							}}
+						/>
+						<span className="name">{tag}</span>
+					</button>
+				);
+			})}
+		</div>
+	);
+};
