@@ -0,0 +1,13 @@
+/**
+ * Turns lines of text into an array literal: "a\nb\nc" becomes ['a', 'b', 'c'].
+ * Blank lines are skipped, and quotes and backslashes are escaped.
+ */
+export function linesToArray(text: string) {
+	const items = text
+		.split(/\r?\n/)
+		.map(line => line.trim())
+		.filter(line => line !== '')
+		.map(line => `'${line.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`);
+
+	return `[${items.join(', ')}]`;
+}
